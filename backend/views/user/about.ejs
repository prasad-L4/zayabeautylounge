  >
    Discover expert beauty tips, hair care advice, makeup inspiration
    and skincare insights to help you look and feel your best.
  </p>

</div>

      </div>
    </div>
    <!-- Section Heading -->
    <div
      class="row justify-content-lg-between justify-content-center  align-items-end"
    >

      <div class="col-lg-7">
        <div class="title-area text-center text-lg-start">

          <h2 class="sec-title text-anime-style-3 text-white">
    
          </h2>

     

        </div>
      </div>


      <div class="col-auto">
    
      </div>

    </div>


    <!-- Blog Cards -->
    <div
      class="swiper th-slider has-shadow"
      id="beautyInsightsSlider"
      data-slider-options='{"paginationType":"bullets","loop":false,"spaceBetween":24,"breakpoints":{"0":{"slidesPerView":1},"576":{"slidesPerView":2},"1200":{"slidesPerView":3}}}'
    >
      <div class="swiper-wrapper">
        <% if (blogs && blogs.length) { %>
          <% blogs.forEach((blog) => {
            const blogUrl = `/blog/${encodeURIComponent(blog.slug)}`;
            const publishedAt = blog.createdAt ? new Date(blog.createdAt) : null;
            const hasPublishedAt = publishedAt && !Number.isNaN(publishedAt.getTime());
            const excerpt = String(blog.content || "")
              .replace(/<[^>]*>/g, " ")
              .replace(/\s+/g, " ")
              .trim()
              .slice(0, 180);
          %>
            <div class="swiper-slide">
              <div class="blog-card">
                <div class="blog-meta">
                  <a href="<%= blogUrl %>">
                    <i class="fa-solid fa-user"></i>
                    <%= blog.author || "Zaya Beauty Lounge" %>
                  </a>
                  <a href="/blog">
                    <i class="fa-solid fa-tags"></i>
                    Beauty Insights
                  </a>
                </div>
        
                <h3 class="box-title">
                  <a href="<%= blogUrl %>"><%= blog.title %></a>
                </h3>
        
                <div class="box-wrapp">
                  <div class="box-img global-img">
                    <a href="<%= blogUrl %>">
                      <img
                        src="<%= blog.imageUrl %>"
                        alt="<%= blog.title %>"
                        loading="lazy"
                      />
                    </a>
                  </div>
                  <% if (hasPublishedAt) { %>
                    <a class="date" href="<%= blogUrl %>">
                      <span class="day"><%= publishedAt.toLocaleDateString("en-US", { day: "2-digit" }) %></span>
                      <span class="year"><%= publishedAt.toLocaleDateString("en-US", { month: "short", year: "numeric" }) %></span>
                    </a>
                  <% } %>
                </div>
        
                <div class="box-content">
                  <p class="box-text"><%= excerpt %><%= excerpt.length === 180 ? "..." : "" %></p>
                  <a href="<%= blogUrl %>" class="th-btn2 style2 th-icon">READ MORE</a>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div class="swiper-slide">
            <p class="text-center">Beauty insights are being added soon.</p>
          </div>
        <% } %>
      </div>
      <div class="slider-pagination"></div>
    </div>
  </div>
    <div class=" d-flex justify-content-center mt-5">
            <a href="/blog" class="th-btn style1">VIEW ALL INSIGHTS</a>
          </div>
</section>
