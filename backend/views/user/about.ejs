    <section class="overflow-hidden position-relative  space-top" id="testi-sec">
      <div class="container-fluid pe-xl-5 ps-xl-5">
        <div class="title-area text-center d-flex flex-column justify-content-center align-items-center">
          <h2 class="sec-title text-anime-style-3 text-white">
            Our Happy Clients Feedbacks
          </h2>
          <span class="title-img d-flex flex-column justify-content-center align-items-center"
            ><img src="assets/img/theme-img/title_shape.svg" alt="shape"
          /></span>
        </div>
        <div class="slider-wrap">
          <div
            class="swiper th-slider has-shadow"
            id="testiSlide2"
            data-slider-options='{"paginationType": "progressbar","loop":false,"breakpoints": {"0":{"slidesPerView": 1},"576": {"slidesPerView": 1},"768": {"slidesPerView": 2},"1200": {"slidesPerView": 3}}}'
          >
            <div class="swiper-wrapper">
              <% if (testimonials && testimonials.length) { %>
                <% testimonials.forEach((testimonial) => {
                  const rating = Math.max(0, Math.min(5, Math.round(Number(testimonial.rating) || 0)));
                %>
                  <div class="swiper-slide">
                    <div class="testi-box">
                      <% if (rating) { %>
                        <span class="rating" role="img" aria-label="<%= rating %> out of 5 stars">
                          <% for (let star = 0; star < rating; star += 1) { %>
                            <i class="fa-sharp fa-solid fa-star-sharp" aria-hidden="true"></i>
                          <% } %>
                        </span>
                      <% } %>
                      <p class="box-text"><%= testimonial.content %></p>
                      <div class="box-wrapp">
                        <div class="box-profile">
                          <div class="box-author">
                            <img
                              src="<%= testimonial.imageUrl || 'assets/img/testimonial/testi_1_1.png' %>"
                              alt="<%= testimonial.name %>"
                              loading="lazy"
                            />
                          </div>
                          <div class="box-info">
                            <h3 class="box-title"><%= testimonial.name %></h3>
                            <span class="box-desig"><%= testimonial.designation || "Customer" %></span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                <% }); %>
              <% } else { %>
                <div class="swiper-slide">
                  <p class="text-center">Client testimonials are being added soon.</p>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </section>
