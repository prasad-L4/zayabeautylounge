<section class="zs-section position-relative overflow-hidden" id="service-sec">
  <div class="container">
 
    <!-- Filters + search -->
    <div class="zs-toolbar">
      <div class="zs-filters" role="tablist">
        <button
          type="button"
          class="zs-pill <%= selectedCategory === 'all' ? 'is-active' : '' %>"
          data-filter="all"
        >All Services</button>
        <% (categories || []).forEach((category) => { %>
          <button
            type="button"
            class="zs-pill <%= selectedCategory === String(category._id) ? 'is-active' : '' %>"
            data-filter="<%= category._id %>"
          >
            <%= category.name %>
          </button>
        <% }); %>
      </div>
      <label class="zs-search">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
        <input type="search" id="zsSearch" placeholder="Search services..." aria-label="Search services" />
      </label>
    </div>
 
    <!-- Cards -->
    <div class="zs-grid" id="zsGrid">
      <% (services || []).forEach((service) => {
        const serviceCategory = (categories || []).find(
          (item) => item.name.toLowerCase() === (service.category || "").toLowerCase()
        );
        const categoryKey = service.categoryId || (serviceCategory && serviceCategory._id) || "other";
        const serviceImage = Array.isArray(service.images) && service.images.length
          ? service.images[0]
          : "assets/img/zaya/ser-5.jpg";
        const serviceDuration = service.duration !== null && service.duration !== undefined && service.duration !== ""
          ? `${service.duration} Mins`
          : "Not specified";
        const servicePrice = service.price !== null && service.price !== undefined && service.price !== ""
          ? `₹ ${Number(service.price).toLocaleString("en-IN")}`
          : "Price varies";
        const bookingMessage =
          "Hello Zaya Beauty Lounge,\n\n" +
          "I would like to book the following service:\n\n" +
          `Service: ${service.title}\n` +
          `Duration: ${serviceDuration}\n` +
          `Price: ${servicePrice}\n\n` +
          "Please let me know the available slots.\n" +
          "My preferred available time: ";
      %>
        <article class="zs-card" data-category="<%= categoryKey %>">
          <a href="/services/<%= service.slug %>" class="zs-card__img">
            <img
              src="<%= serviceImage %>"
              alt="<%= service.title %>"
              loading="lazy"
            />
          </a>
          <div class="zs-card__body">
            <h3 class="zs-card__title">
              <a href="/services/<%= service.slug %>"><%= service.title %></a>
            </h3>
            <p class="zs-card__desc"><%= service.shortDescription %></p>
            <div class="zs-card__meta">
              <span class="zs-card__time">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9"/>
                  <path d="M12 7v5l3 2"/>
                </svg>
                <%= serviceDuration %>
              </span>
              <span class="zs-card__price">
                <% if (service.price !== null && service.price !== undefined && service.price !== "") { %>
                  &#8377; <%= Number(service.price).toLocaleString("en-IN") %>
                <% } else { %>
                  Price varies
                <% } %>
              </span>
            </div>
            <a
              href="https://wa.me/918848899513?text=<%= encodeURIComponent(bookingMessage) %>"
              class="zs-book"
              target="_blank"
              rel="noopener"
            >
              Book Now
              <span class="zs-book__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 6l6 6-6 6"/>
                </svg>
              </span>
            </a>
          </div>
        </article>
      <% }); %>

    </div>
    <p class="zs-empty" id="zsEmpty" <%= services && services.length ? 'style="display:none"' : '' %>>
      <%= services && services.length ? "No services found. Try a different search or category." : "Services are being added soon. Please check back." %>
    </p>
 
 
  </div>
</section>
<script>
  (() => {
    const grid = document.getElementById("zsGrid");
    const search = document.getElementById("zsSearch");
    const emptyState = document.getElementById("zsEmpty");
    const cards = Array.from(grid.querySelectorAll(".zs-card"));
    const activeFilter = document.querySelector(".zs-pill.is-active");
    let activeCategory = activeFilter ? activeFilter.dataset.filter : "all";

    cards.forEach((card) => {
      const image = card.querySelector(".zs-card__img img");
      if (!image) return;

      const hideBrokenImage = () => {
        image.hidden = true;
        image.parentElement.classList.add("is-unavailable");
      };

      image.addEventListener("error", hideBrokenImage, { once: true });
      if (image.complete && image.naturalWidth === 0) hideBrokenImage();
    });

    function filterServices() {
      const query = search.value.trim().toLowerCase();
      let visibleCount = 0;
      cards.forEach((card) => {
        const matchesCategory =
          activeCategory === "all" ||
          card.dataset.category === activeCategory;
        const matchesSearch = !query || card.textContent.toLowerCase().includes(query);
        card.hidden = !(matchesCategory && matchesSearch);
        if (!card.hidden) visibleCount += 1;
      });
      emptyState.style.display = visibleCount ? "none" : "block";
    }

    document.querySelectorAll(".zs-pill").forEach((button) => {
      button.addEventListener("click", () => {
        document.querySelector(".zs-pill.is-active")?.classList.remove("is-active");
        button.classList.add("is-active");
        activeCategory = button.dataset.filter;
        filterServices();
      });
    });
    search.addEventListener("input", filterServices);
  })();
</script>
