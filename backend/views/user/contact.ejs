<section class="space-bottom overflow-hidden">
  <div class="container">
    <div class="row gy-40">
      <div class="col-12">

        <form
          action="/api/enquiries"
          method="POST"
          class="contact-form style2"
          id="contactEnquiryForm"
        >

          <h3 class="mb-4 mt-n2 text-center">Get In Touch</h3>

          <div class="row">

            <!-- Name -->
            <div class="form-group col-md-6">
              <input
                type="text"
                class="form-control"
                name="name"
                id="name"
                placeholder="Your Name"
                required
              />
              <i class="fal fa-user"></i>
            </div>

            <!-- Email -->
            <div class="form-group col-md-6">
              <input
                type="email"
                class="form-control"
                name="email"
                id="email"
                placeholder="Email Address"
                required
              />
              <i class="fal fa-envelope"></i>
            </div>

            <!-- Phone -->
            <div class="form-group col-md-6">
              <input
                type="tel"
                class="form-control"
                name="phone"
                id="phone"
                placeholder="Phone Number"
                required
              />
              <i class="fal fa-phone"></i>
            </div>

            <!-- Service -->
            <div class="form-group col-md-6">
              <input
                type="text"
                class="form-control"
                name="serviceInterest"
                id="serviceInterest"
                placeholder="Service You Are Interested In"
                required
              />
              <i class="fal fa-spa"></i>
            </div>

            <!-- Message -->
            <div class="form-group col-12">
              <textarea
                name="message"
                id="message"
                cols="30"
                rows="3"
                class="form-control"
                placeholder="Your Message"
              ></textarea>
              <i class="fal fa-comment"></i>
            </div>

            <!-- Button -->
            <div class="form-btn col-12">
              <button type="submit" class="th-btn fw-btn">
                SEND MESSAGE
              </button>
            </div>

          </div>

          <p
            class="form-messages contact-toast mb-0 mt-3"
            role="status"
            aria-live="polite"
            aria-hidden="true"
          ></p>

        </form>

      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const form = document.getElementById("contactEnquiryForm");
    if (!form) return;

    const messageElement = form.querySelector(".form-messages");
    const submitButton = form.querySelector('button[type="submit"]');
    let toastTimeout;

    const hideToast = () => {
      window.clearTimeout(toastTimeout);
      messageElement.classList.remove("success", "error");
      messageElement.setAttribute("aria-hidden", "true");
      messageElement.textContent = "";
    };

    const showToast = (message, type) => {
      hideToast();
      messageElement.textContent = message;
      messageElement.classList.add(type);
      messageElement.setAttribute("aria-hidden", "false");
      toastTimeout = window.setTimeout(hideToast, 5000);
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      hideToast();
      submitButton.disabled = true;

      const formData = new FormData(form);
      const serviceInterest = String(formData.get("serviceInterest") || "").trim();
      const message = String(formData.get("message") || "").trim();
      const enquiryMessage = [
        serviceInterest ? `Service interested in: ${serviceInterest}` : "",
        message,
      ]
        .filter(Boolean)
        .join("\n\n");

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: formData.get("name"),
            email: formData.get("email"),
            phone: formData.get("phone"),
            message: enquiryMessage,
            source: "contact",
          }),
        });
        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || "Unable to send your enquiry. Please try again.");
        }

        showToast(result.message || "Your enquiry has been sent successfully.", "success");
        form.reset();
      } catch (error) {
        showToast(
          error instanceof Error
            ? error.message
            : "Unable to send your enquiry. Please try again.",
          "error"
        );
      } finally {
        submitButton.disabled = false;
      }
    });
  })();
</script>

