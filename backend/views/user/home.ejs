              <span class="title-img">
                <img src="assets/img/theme-img/title_shape.svg" alt="Beauty Services" />
              </span>
            </div>
          </div>
    
          <div class="col-lg-5">
            <div class="sec-btn wow fadeInUp text-center text-lg-start">
              <p class="sec-text2">
                Discover professional beauty services at Zaya Beauty Lounge,
                from bridal makeup and hair styling to skincare, nails and
                personalized beauty care.
              </p>
            </div>
          </div>
        </div>
    
        <div class="row gy-4 justify-content-center">
          <% (categories || []).forEach((category) => {
            const categoryId = String(category._id);
            const categoryName = category.title || category.name;
            const categoryImage = category.image || "assets/img/zaya/ser-2.png";
          %>
            <div class="col-6 col-md-6 col-xl-4">
              <div
                class="th-service service-block zm-trigger"
                data-zm="<%= categoryId %>"
                role="button"
                tabindex="0"
                aria-haspopup="dialog"
              >
                <div class="box-img">
                  <img src="<%= categoryImage %>" alt="<%= category.alt_text || categoryName %>" />
                  <span class="zm-count"></span>
                </div>
                <h3 class="box-title">
                  <a href="/services?category=<%= encodeURIComponent(categoryId) %>"><%= categoryName %></a>
                </h3>
              </div>
            </div>
          <% }); %>
          <% if (!categories || !categories.length) { %>
            <p class="text-center text-white">Services are being added soon. Please check back.</p>
          <% } %>
        </div>
      </div>
    
      <div class="sec-btn mt-60 mb-0 text-center">
        <a href="/services" class="th-btn2 th-icon">BROWSE ALL SERVICES</a>
      </div>
    </section>
    
    <div class="zm-overlay" id="zmOverlay" aria-hidden="true" data-whatsapp="918848899513">
      <div class="zm-sheet" role="dialog" aria-modal="true" aria-label="Services">
        <div class="zm-handle"><span></span></div>
        <button type="button" class="zm-close" aria-label="Close">
          <svg viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
    
        <% (categories || []).forEach((category) => {
          const categoryId = String(category._id);
          const categoryName = category.title || category.name;
          const categoryImage = category.image || "assets/img/zaya/ser-2.png";
          const categoryServices = (services || []).filter((service) => {
            if (service.categoryId) {
              return String(service.categoryId) === categoryId;
            }
    
            const legacyCategory = String(service.category || "").trim().toLowerCase();
            return [category.name, category.title]
              .filter(Boolean)
              .some((name) => String(name).trim().toLowerCase() === legacyCategory);
          });
        %>
          <div class="zm-panel" data-zm-panel="<%= categoryId %>">
            <div class="zm-head">
              <img class="zm-thumb" src="<%= categoryImage %>" alt="<%= category.alt_text || categoryName %>" />
              <div class="zm-headtext">
                <p class="zm-eyebrow">Browse collection</p>
                <h3 class="zm-title"><%= categoryName %></h3>
              </div>
              <a class="zm-all" href="/services?category=<%= encodeURIComponent(categoryId) %>">View all in this category</a>
            </div>
            <div class="zm-body">
              <div class="zm-grid">
                <% categoryServices.forEach((service) => {
                  const serviceImage =
                    Array.isArray(service.images) && service.images.length
                      ? service.images[0]
                      : "assets/img/zaya/ser-5.jpg";
                %>
                  <article class="zm-card">
                    <div class="zm-card__img">
                      <img src="<%= serviceImage %>" alt="<%= service.title %>" loading="lazy" />
                    </div>
                    <div class="zm-card__body">
                      <h4 class="zm-card__title"><%= service.title %></h4>
                      <p class="zm-card__desc"><%= service.shortDescription %></p>
                      <div class="zm-card__meta">
                        <span class="zm-card__time">
                          <%= service.duration !== null && service.duration !== undefined && service.duration !== ""
                            ? `${service.duration} Mins`
                            : "Not specified" %>
                        </span>
                        <span class="zm-card__price">
                          <% if (service.price !== null && service.price !== undefined && service.price !== "") { %>
                            &#8377; <%= Number(service.price).toLocaleString("en-IN") %>
                          <% } else { %>
                            Price varies
                          <% } %>
                        </span>
                      </div>
                      <button type="button" class="zm-book">Book Now</button>
                    </div>
                  </article>
                <% }); %>
                <% if (!categoryServices.length) { %>
                  <p class="text-center">Services in this category are being added soon.</p>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
