	<%- include('../partial/header') %>

    <% if (desktopBanners.length || mobileBanners.length) { %>
      <div class="th-hero-wrapper hero-1" id="hero">
        <% const getSafeBannerLink = (url) =>
          typeof url === "string" &&
          (/^\/(?!\/)/.test(url) || /^https?:\/\//i.test(url))
            ? url
            : ""; %>
        <% if (desktopBanners.length) { %>
          <div
            class="swiper th-slider hero-desktop-slider"
            id="heroSlide1"
            data-slider-options='<%= JSON.stringify({
              effect: "fade",
              loop: desktopBanners.length > 1,
              speed: 1800,
              autoplay: desktopBanners.length > 1
                ? { delay: 5000, disableOnInteraction: false }
                : false,
            }) %>'
          >
            <div class="swiper-wrapper">
              <% desktopBanners.forEach((banner) => { %>
                <% const bannerLink = getSafeBannerLink(banner.link); %>
                <div class="swiper-slide">
                  <% if (bannerLink) { %>
                    <a class="hero-banner-link" href="<%= bannerLink %>">
                  <% } %>
                  <img
                    class="hero-banner-image"
                    src="<%= banner.image %>"
                    alt="<%= banner.title || banner.subtitle || 'Beauty salon banner' %>"
                  />
                  <% if (bannerLink) { %>
                    </a>
                  <% } %>
                </div>
              <% }); %>
            </div>
            <% if (desktopBanners.length > 1) { %>
              <div class="slider-dots">
                <div class="slider-pagination" data-slider-id="#heroSlide1"></div>
              </div>
            <% } %>
          </div>
        <% } %>

        <% if (mobileBanners.length) { %>
          <div
            class="swiper th-slider hero-mobile-slider"
            id="heroSlideMobile"
            data-slider-options='<%= JSON.stringify({
              effect: "fade",
              loop: mobileBanners.length > 1,
              speed: 1800,
              autoplay: mobileBanners.length > 1
                ? { delay: 5000, disableOnInteraction: false }
                : false,
            }) %>'
          >
            <div class="swiper-wrapper">
              <% mobileBanners.forEach((banner) => { %>
                <% const bannerLink = getSafeBannerLink(banner.link); %>
                <div class="swiper-slide">
                  <% if (bannerLink) { %>
                    <a class="hero-banner-link" href="<%= bannerLink %>">
                  <% } %>
                  <img
                    class="hero-banner-image"
                    src="<%= banner.image %>"
                    alt="<%= banner.title || banner.subtitle || 'Beauty salon banner' %>"
                  />
                  <% if (bannerLink) { %>
                    </a>
                  <% } %>
                </div>
              <% }); %>
            </div>
            <% if (mobileBanners.length > 1) { %>
              <div class="slider-pagination hero-mobile-pagination"></div>
            <% } %>
          </div>
        <% } %>
      </div>
    <% } %>
    <section class="position-relative overflow-hidden space" id="service-sec">
      <div class="container">
