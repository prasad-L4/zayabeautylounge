<section class="zr-section" id="reels-sec">
  <div class="container">

    <div class="zr-head">
      <h2 class="zr-title">Watch our latest reels</h2>
      <p class="zr-sub">Real transformations, real clients. Tap any reel to play or pause.</p>
    </div>

    <div class="zr-track">
      <% if (tips && tips.length) { %>
        <% tips.forEach((tip) => { %>
          <div class="zr-card">
            <div
              class="zr-frame zr-frame--embed"
              data-reel="<%= tip.reelUrl %>"
              <% if (tip.title) { %>aria-label="<%= tip.title %>"<% } %>
            ></div>
          </div>
        <% }); %>
      <% } else { %>
        <p class="zr-sub">New beauty tips are coming soon.</p>
      <% } %>
    </div>

    <div class="zr-cta">
      <a href="https://www.instagram.com/YOUR_USERNAME/" target="_blank" rel="noopener" class="zr-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="1" fill="#fff"/>
        </svg>
        Follow us on Instagram
      </a>
    </div>

  </div>
</section>

<script>
  (function () {
    var frames = document.querySelectorAll(".zr-frame");

    frames.forEach(function (frame) {
      // ----- link based reel (Instagram's official embed script) -----
      if (frame.dataset.reel) {
        var m = frame.dataset.reel.match(/instagram\.com\/(reel|reels|p|tv)\/([A-Za-z0-9_-]+)/);
        if (!m) return;
        var type = m[1] === "reels" ? "reel" : m[1];
        var postUrl = "https://www.instagram.com/" + type + "/" + m[2] + "/";
        var mount = function () {
          if (frame.dataset.done) return;
          frame.dataset.done = "1";
          var quote = document.createElement("blockquote");
          quote.className = "instagram-media";
          quote.setAttribute("data-instgrm-permalink", postUrl);
          quote.setAttribute("data-instgrm-version", "14");
          quote.style.cssText = "background:#fff;border:0;margin:0;max-width:100%;min-width:0;padding:0;width:100%;";

          var link = document.createElement("a");
          link.href = postUrl;
          link.target = "_blank";
          link.rel = "noopener";
          link.textContent = "Open this reel on Instagram";
          quote.appendChild(link);
          frame.appendChild(quote);

          var observer = new MutationObserver(function () {
            var iframe = frame.querySelector("iframe");
            if (iframe) {
              observer.disconnect();
              iframe.addEventListener("load", function () {
                frame.classList.add("is-loaded");
              }, { once: true });
            }
          });
          observer.observe(frame, { childList: true, subtree: true });

          var processEmbeds = function () {
            if (window.instgrm && window.instgrm.Embeds) {
              window.instgrm.Embeds.process();
            }
          };

          if (window.instgrm && window.instgrm.Embeds) {
            processEmbeds();
          } else {
            var script = document.querySelector('script[src="https://www.instagram.com/embed.js"]');
            if (!script) {
              script = document.createElement("script");
              script.src = "https://www.instagram.com/embed.js";
              script.async = true;
              script.onload = processEmbeds;
              script.onerror = function () {
                frame.classList.add("is-loaded");
              };
              document.body.appendChild(script);
            } else {
              script.addEventListener("load", processEmbeds, { once: true });
            }
          }
        };
        if ("IntersectionObserver" in window) {
          var io = new IntersectionObserver(function (en) {
            if (en[0].isIntersecting) { mount(); io.disconnect(); }
          }, { rootMargin: "300px" });
          io.observe(frame);
        } else { mount(); }
        return;
      }

      // ----- video file reel -----
      var video = frame.querySelector(".zr-video");
      var sound = frame.querySelector(".zr-sound");
      var userPaused = false;

      video.addEventListener("loadeddata", function () { frame.classList.add("is-loaded"); });
      video.addEventListener("play",  function () { frame.classList.remove("is-paused"); });
      video.addEventListener("pause", function () { frame.classList.add("is-paused"); });

      function play() {
        var p = video.play();
        if (p && p.catch) p.catch(function () {});
      }

      // tap the video = play / pause
      frame.addEventListener("click", function (e) {
        if (sound && sound.contains(e.target)) return;
        if (video.paused) { userPaused = false; play(); }
        else { userPaused = true; video.pause(); }
      });

      // sound button (only one reel has sound at a time)
      if (sound) {
        sound.addEventListener("click", function () {
          var turnOn = video.muted;
          document.querySelectorAll(".zr-video").forEach(function (v) { v.muted = true; });
          document.querySelectorAll(".zr-sound").forEach(function (b) { b.classList.remove("is-on"); });
          if (turnOn) { video.muted = false; sound.classList.add("is-on"); }
        });
      }

      // autoplay (muted) when visible, pause when scrolled away
      if ("IntersectionObserver" in window) {
        new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { if (!userPaused) play(); }
            else { video.pause(); }
          });
        }, { threshold: 0.6 }).observe(frame);
      } else {
        frame.classList.add("is-paused");
      }
    });
  })();
</script>

