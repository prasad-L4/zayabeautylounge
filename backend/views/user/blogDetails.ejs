    <section
      class="th-blog-wrapper blog-details overflow-hidden  "
    >
      <div class="container">
        <div class="row gx-40 flex-row-reverse">
          <div class="col-xxl-12 col-lg-12">
            <div class="th-blog blog-single">
              <div class="th-clip-anim mb-24">
                <img
                  class="th-anim-img"
                  data-animate="true"
                  src="<%= blog.imageUrl %>"
                  alt="<%= blog.title %>"
                />
              </div>
              <div class="blog-content">
                <div class="blog-meta">
                  <a class="author" href="/blog">
                    <i class="fa-solid fa-user"></i> <%= blog.author %>
                  </a>
                  <a href="/blog">
                    <i class="fa-solid fa-tags"></i> Beauty Insights
                  </a>
                </div>
                <h1 class="blog-title"><%= blog.title %></h1>
                <div class="blog-desc blog-content-body"><%- blog.content %></div>
                <div class="share-links clearfix">
                  <div class="row justify-content-between">
                    <div class="col-sm-auto">
                      <div class="tagcloud">
                        <% (blog.metaKeywords || []).forEach((keyword) => { %>
                          <a href="/blog"><%= keyword %></a>
                        <% }); %>
                      </div>
                    </div>
             
                  </div>
                </div>
            
              </div>
            </div>
        
     
          </div>
       
        </div>
      </div>
