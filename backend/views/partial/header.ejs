    <div class="zy-search" id="zySearch" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Search">
  <div class="zy-search__backdrop" data-zy-search-close></div>
 
  <div class="zy-search__panel">
    <button type="button" class="zy-search__close" aria-label="Close search" data-zy-search-close>
      <i class="far fa-times" aria-hidden="true"></i>
    </button>
 
    <span class="zy-search__eyebrow">Discover</span>
    <h3 class="zy-search__title">What are you looking for?</h3>
 
    <form class="zy-search__form" id="zySearchForm" autocomplete="off">
