<script>
    /* =========================================================
   ZAYA SEARCH MODAL
   ========================================================= */
(function () {
  var modal = document.getElementById('zySearch');
  if (!modal) return;

  var WA = 'https://wa.me/918848899513?text=';
  var DEFAULT_COUNT = 4;
  var MIN_SEARCH_LENGTH = 3;
  var SERVICES = <%- JSON.stringify(headerServices || []).replace(/</g, "\\u003c") %>;

  var input = document.getElementById('zySearchInput');
  var form = document.getElementById('zySearchForm');
  var clearBtn = document.getElementById('zySearchClear');
  var recentWrap = document.getElementById('zyRecentWrap');
  var recentList = document.getElementById('zyRecentList');
  var recentClear = document.getElementById('zyRecentClear');
  var cardsEl = document.getElementById('zyCards');
  var emptyMsg = document.getElementById('zyEmpty');
  var titleEl = document.getElementById('zyResultsTitle');
  var KEY = 'zayaRecentSearches';
  var MAX = 6;

  /* ---------- helpers ---------- */
  function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function money(n) {
    return n !== null && n !== undefined && n !== ''
      ? '₹ ' + Number(n).toLocaleString('en-IN')
      : '';
  }

  /* ---------- render cards ---------- */
  function renderCards(list) {
    cardsEl.innerHTML = list.map(function (s, i) {
      var hasDuration = s.duration !== null && s.duration !== undefined && s.duration !== '';
      var hasPrice = s.price !== null && s.price !== undefined && s.price !== '';
      var duration = hasDuration ? s.duration + ' Mins' : '';
      var price = money(s.price);
      var image = s.images && s.images.length ? s.images[0] : '';
      var message =
        'Hello Zaya Beauty Lounge,\n\n' +
        'I would like to book the following service:\n\n' +
        'Service: ' + s.title + '\n' +
        (hasDuration ? 'Duration: ' + duration + '\n' : '') +
        (hasPrice ? 'Price: ' + price + '\n' : '') +
        '\n' +
        'Please let me know the available slots.\n' +
        'My preferred available time: ';
      var wa = WA + encodeURIComponent(message);
      return '' +
        '<article class="zy-card" style="--i:' + i + '">' +
          '<div class="zy-card__img">' +
            '<img loading="lazy" src="' + esc(image) + '" alt="' + esc(s.title) + '">' +
          '</div>' +
          '<div class="zy-card__body">' +
            '<h5>' + esc(s.title) + '</h5>' +
            '<p>' + esc(s.shortDescription || '') + '</p>' +
            (hasDuration || hasPrice
              ? '<div class="zy-card__meta">' +
                  (hasDuration ? '<span><i class="far fa-clock"></i> ' + esc(duration) + '</span>' : '') +
                  (hasPrice ? '<strong>' + esc(price) + '</strong>' : '') +
                '</div>'
              : '') +
            '<a class="zy-card__btn" href="' + wa + '" target="_blank" rel="noopener" data-title="' + esc(s.title) + '">' +
              'Book Now <i class="far fa-chevron-right"></i>' +
            '</a>' +
          '</div>' +
        '</article>';
    }).join('');
    emptyMsg.classList.toggle('show', list.length === 0);
  }

  /* ---------- live filter ---------- */
  function filter() {
    var q = input.value.trim().toLowerCase();
    clearBtn.classList.toggle('show', q.length > 0);

    if (!q) {
      titleEl.textContent = 'Popular Services';
      emptyMsg.textContent = 'No matching services found.';
      renderCards(SERVICES.slice(0, DEFAULT_COUNT));
      return;
    }
    if (q.length < MIN_SEARCH_LENGTH) {
      titleEl.textContent = 'Search services';
      emptyMsg.textContent = 'Enter at least 3 characters to search.';
      renderCards([]);
      return;
    }
    emptyMsg.textContent = 'No matching services found.';
    var res = SERVICES.filter(function (s) {
      return (s.title + ' ' + (s.shortDescription || '') + ' ' + (s.category || ''))
        .toLowerCase().indexOf(q) !== -1;
    });
    titleEl.textContent = res.length + ' Result' + (res.length === 1 ? '' : 's');
    renderCards(res);
  }

  /* ---------- open / close ---------- */
  function openModal() {
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';
    renderRecent();
    filter(); // replays the card entrance animation
    setTimeout(function () { input.focus(); }, 350);
  }
  function closeModal() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
  }
  document.querySelectorAll('[data-zy-search-open]').forEach(function (b) {
    b.addEventListener('click', openModal);
  });
  modal.querySelectorAll('[data-zy-search-close]').forEach(function (b) {
    b.addEventListener('click', closeModal);
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
  });

  /* ---------- recent searches (localStorage) ---------- */
  function getRecent() {
    try { return JSON.parse(localStorage.getItem(KEY)) || []; } catch (e) { return []; }
  }
  function setRecent(arr) {
    try { localStorage.setItem(KEY, JSON.stringify(arr)); } catch (e) {}
  }
  function addRecent(term) {
    term = (term || '').trim();
    if (!term) return;
    var list = getRecent().filter(function (t) { return t.toLowerCase() !== term.toLowerCase(); });
    list.unshift(term);
    setRecent(list.slice(0, MAX));
  }
  function renderRecent() {
    var list = getRecent();
    recentList.innerHTML = '';
    recentWrap.style.display = list.length ? '' : 'none';

    list.forEach(function (term) {
      var li = document.createElement('li');
      li.innerHTML =
        '<i class="far fa-clock"></i><span></span>' +
        '<b class="zy-chip-x" title="Remove"><i class="far fa-times"></i></b>';
      li.querySelector('span').textContent = term;

      li.addEventListener('click', function (e) {
        if (e.target.closest('.zy-chip-x')) {
          setRecent(getRecent().filter(function (t) { return t !== term; }));
          renderRecent();
          return;
        }
        input.value = term;
        filter();
        input.focus();
      });
      recentList.appendChild(li);
    });
  }
  recentClear.addEventListener('click', function () {
    setRecent([]);
    renderRecent();
  });

  /* ---------- events ---------- */
  var timer;
  input.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(filter, 120); // small debounce for smoothness
  });
  clearBtn.addEventListener('click', function () {
    input.value = '';
    filter();
    input.focus();
  });
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var q = input.value.trim();
    if (!q) return;
    addRecent(q);
    renderRecent();
  });
  // clicking Book Now saves the service name as a recent search
  cardsEl.addEventListener('click', function (e) {
    var btn = e.target.closest('.zy-card__btn');
    if (btn) addRecent(btn.getAttribute('data-title'));
  });

  filter();
})();
</script>