<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Instagram Tips | Zaya Admin</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
    <link rel="stylesheet" href="/admin-css/admin.css" />
  </head>
  <body>
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-inner">
        <div class="brand">
          <div class="brand-icon"><i class="bi bi-flower1"></i></div>
          <div class="brand-content">
            <h1>Zaya</h1>
            <span>Service Listing</span>
          </div>
        </div>
        <nav class="sidebar-nav">
          <a href="/admin/dashboard" class="nav-item">
            <i class="bi bi-house-fill"></i><span>Dashboard</span>
          </a>
          <a href="/admin/services" class="nav-item">
            <i class="bi bi-grid-3x3-gap"></i><span>Services</span>
          </a>
                    <a href="/admin/categories" class="nav-item "><i class="bi bi-tags"></i><span>Categories</span></a>
          <a href="/admin/main-banners" class="nav-item">
            <i class="bi bi-image"></i><span>Main Banners</span>
          </a>
          <a href="/admin/mobile-banners" class="nav-item">
            <i class="bi bi-image"></i><span>Mobile Banners</span>
          </a>
          <a href="/admin/blogs" class="nav-item">
            <i class="bi bi-file-earmark-text"></i><span>Blogs</span>
          </a>
          <a href="/admin/gallery" class="nav-item">
            <i class="bi bi-images"></i><span>Gallery</span>
          </a>
          <a href="/admin/poster" class="nav-item">
            <i class="bi bi-card-image"></i><span>Posters</span>
          </a>
          <a href="/admin/tips" class="nav-item active">
            <i class="bi bi-instagram"></i><span>Instagram Tips</span>
          </a>
          <a href="/admin/testimonials" class="nav-item">
            <i class="bi bi-chat-square-text"></i><span>Testimonials</span>
          </a>
          <a href="/admin/enquiries" class="nav-item">
            <i class="bi bi-inbox"></i><span>Enquiries</span>
          </a>
        </nav>
        <div class="sidebar-bottom">
          <a href="/admin/logout" class="logout-link">
            <i class="bi bi-box-arrow-right"></i><span>Logout</span>
          </a>
        </div>
      </div>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <main class="main-content">
      <header class="top-header">
        <div class="header-left">
          <button class="sidebar-toggle" id="sidebarToggle" type="button">
            <i class="bi bi-list"></i>
          </button>
        </div>
        <div class="header-right">
          <div class="header-user">
            <div class="header-user-info"><strong>Zaya</strong><span>Admin</span></div>
            <div class="header-user-avatar">
              <img src="/assets/img/zaya/logo.png" alt="Admin" style="object-fit: contain" />
            </div>
          </div>
        </div>
      </header>

      <div class="dashboard-content banners-page">
        <div class="banners-page-header">
          <div class="page-title-wrapper">
            <h2>Instagram Tips</h2>
            <div class="breadcrumb-custom">
              <a href="/admin/dashboard">Dashboard</a>
              <i class="bi bi-chevron-right"></i>
              <span>Instagram Tips</span>
            </div>
          </div>
          <button
            class="add-banner-btn border-0"
            id="addTipButton"
            type="button"
            data-bs-toggle="modal"
            data-bs-target="#tipModal"
          >
            <i class="bi bi-plus-lg"></i><span>Add Reel</span>
          </button>
        </div>

        <div class="banners-toolbar">
          <div class="banner-filter">
            <select id="tipStatusFilter" aria-label="Filter Instagram Reels by status">
              <option value="">All Status</option>
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>
            <i class="bi bi-chevron-down"></i>
          </div>
        </div>

        <div id="tipPageMessage" class="alert d-none" role="status"></div>
        <div class="row g-3 banners-grid" id="tipsGrid" aria-live="polite"></div>
        <div class="banners-empty" id="tipsEmpty" style="display: none">
          <i class="bi bi-instagram"></i>
          <h4>No Reels found</h4>
          <p>Add an Instagram Reel link to display it here.</p>
        </div>
      </div>
    </main>

    <div
      class="modal fade"
      id="tipModal"
      tabindex="-1"
      aria-labelledby="tipModalTitle"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <form id="tipForm">
            <div class="modal-header">
              <div>
                <h5 class="modal-title" id="tipModalTitle">Add Instagram Reel</h5>
                <p class="text-muted mb-0" id="tipModalDescription">
                  Paste a public Instagram Reel link.
                </p>
              </div>
              <button
                type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close"
              ></button>
            </div>
            <div class="modal-body">
              <div class="mb-3">
                <label for="tipTitle" class="form-label">Title (optional)</label>
                <input
                  type="text"
                  id="tipTitle"
                  name="title"
                  class="form-control"
                  maxlength="120"
                  placeholder="e.g. Hair care routine"
                />
              </div>
              <div class="mb-3">
                <label for="tipReelUrl" class="form-label">Instagram Reel link</label>
                <input
                  type="url"
                  id="tipReelUrl"
                  name="reelUrl"
                  class="form-control"
                  placeholder="https://www.instagram.com/reel/..."
                  required
                />
                <div class="form-text">
                  Use a public Instagram reel, post, or video link.
                </div>
              </div>
              <div class="row g-3">
                <div class="col-6">
                  <label for="tipSortOrder" class="form-label">Sort Order</label>
                  <input
                    type="number"
                    id="tipSortOrder"
                    name="sort_order"
                    class="form-control"
                    min="0"
                    value="0"
                  />
                </div>
                <div class="col-6">
                  <label for="tipStatus" class="form-label">Status</label>
                  <select id="tipStatus" name="is_active" class="form-select">
                    <option value="true" selected>Active</option>
                    <option value="false">Inactive</option>
                  </select>
                </div>
              </div>
              <div id="tipFormMessage" class="alert d-none mt-3 mb-0" role="alert"></div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                Cancel
              </button>
              <button type="submit" class="btn btn-primary" id="saveTipButton">
                <span class="save-tip-label">Save Reel</span>
                <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/admin-js/main.js"></script>
    <script src="/admin-js/tips.js"></script>
  </body>
</html>
