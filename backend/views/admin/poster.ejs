<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Poster Management | Zaya Admin</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
    <link rel="stylesheet" href="/admin-css/admin.css" />
  </head>

  <body>
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-inner">
        <div class="brand">
          <div class="brand-icon"><i class="bi bi-flower1"></i></div>
          <div class="brand-content">
            <h1>Zaya</h1>
            <span>Service Listing</span>
          </div>
        </div>

        <nav class="sidebar-nav">
          <a href="/admin/dashboard" class="nav-item">
            <i class="bi bi-house-fill"></i><span>Dashboard</span>
          </a>
          <a href="/admin/services" class="nav-item">
            <i class="bi bi-grid-3x3-gap"></i><span>Services</span>
          </a>
                    <a href="/admin/categories" class="nav-item "><i class="bi bi-tags"></i><span>Categories</span></a>
          <a href="/admin/main-banners" class="nav-item">
            <i class="bi bi-image"></i><span>Main Banners</span>
          </a>
          <a href="/admin/mobile-banners" class="nav-item">
            <i class="bi bi-image"></i><span>Mobile Banners</span>
          </a>
          <a href="/admin/blogs" class="nav-item">
            <i class="bi bi-file-earmark-text"></i><span>Blogs</span>
          </a>
          <a href="/admin/gallery" class="nav-item">
            <i class="bi bi-images"></i><span>Gallery</span>
          </a>
          <a href="/admin/poster" class="nav-item active">
            <i class="bi bi-card-image"></i><span>Posters</span>
          </a>
                  <a href="/admin/tips" class="nav-item ">
            <i class="bi bi-instagram"></i><span>Instagram Tips</span>
          </a>
          <a href="/admin/testimonials" class="nav-item">
            <i class="bi bi-chat-square-text"></i><span>Testimonials</span>
          </a>
          <a href="/admin/enquiries" class="nav-item">
            <i class="bi bi-inbox"></i><span>Enquiries</span>
          </a>
        </nav>

        <div class="sidebar-bottom">
          <a href="/admin/logout" class="logout-link">
            <i class="bi bi-box-arrow-right"></i><span>Logout</span>
          </a>
        </div>
      </div>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <main class="main-content">
      <header class="top-header">
        <div class="header-left">
          <button class="sidebar-toggle" id="sidebarToggle" type="button">
            <i class="bi bi-list"></i>
          </button>
        </div>
        <div class="header-right">
          <div class="header-user">
            <div class="header-user-info">
              <strong>Zaya</strong>
              <span>Admin</span>
            </div>
            <div class="header-user-avatar">
              <img
                style="object-fit: contain"
                src="/assets/img/zaya/logo.png"
                alt="Admin"
              />
            </div>
          </div>
        </div>
      </header>

      <div class="dashboard-content banners-page">
        <div class="banners-page-header">
          <div class="page-title-wrapper">
            <h2>Posters</h2>
            <div class="breadcrumb-custom">
              <a href="/admin/dashboard">Dashboard</a>
              <i class="bi bi-chevron-right"></i>
              <span>Posters</span>
            </div>
          </div>
          <button
            class="add-banner-btn border-0"
            id="addPosterButton"
            type="button"
            data-bs-toggle="modal"
            data-bs-target="#posterModal"
          >
            <i class="bi bi-plus-lg"></i><span>Add Poster</span>
          </button>
        </div>

        <div class="banners-toolbar">
          <div class="banner-filter">
            <select id="posterStatusFilter" aria-label="Filter posters by status">
              <option value="">All Status</option>
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>
            <i class="bi bi-chevron-down"></i>
          </div>
        </div>

        <div id="posterPageMessage" class="alert d-none" role="status"></div>
        <div class="row g-3 banners-grid" id="postersGrid" aria-live="polite"></div>
        <div class="banners-empty" id="postersEmpty" style="display: none">
          <i class="bi bi-card-image"></i>
          <h4>No posters found</h4>
          <p>Add a poster to see it listed here.</p>
        </div>
      </div>
    </main>

    <div
      class="modal fade"
      id="posterModal"
      tabindex="-1"
      aria-labelledby="posterModalTitle"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
          <form id="posterForm">
            <div class="modal-header">
              <div>
                <h5 class="modal-title" id="posterModalTitle">Add Poster</h5>
                <p class="text-muted mb-0" id="posterModalDescription">
                  Enter the poster details and upload an image.
                </p>
              </div>
              <button
                type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close"
              ></button>
            </div>

            <div class="modal-body">
              <div class="row g-3">
                <div class="col-12 col-md-6">
                  <label for="posterTitle" class="form-label">Title</label>
                  <input
                    type="text"
                    id="posterTitle"
                    name="title"
                    class="form-control"
                    placeholder="Enter poster title"
                  />
                </div>
                <div class="col-12 col-md-6">
                  <label for="posterSortOrder" class="form-label">Sort Order</label>
                  <input
                    type="number"
                    id="posterSortOrder"
                    name="sort_order"
                    class="form-control"
                    min="0"
                    value="0"
                  />
                </div>
                <div class="col-12">
                  <label for="posterAltText" class="form-label">Alt Text</label>
                  <input
                    type="text"
                    id="posterAltText"
                    name="alt_text"
                    class="form-control"
                    placeholder="Describe the poster image"
                  />
                </div>
                <div class="col-12 col-md-6">
                  <label for="posterStatus" class="form-label">Status</label>
                  <select id="posterStatus" name="is_active" class="form-select">
                    <option value="true" selected>Active</option>
                    <option value="false">Inactive</option>
                  </select>
                </div>
                <div class="col-12 col-md-6">
                  <label for="posterImage" class="form-label">Poster Image</label>
                  <input
                    type="file"
                    id="posterImage"
                    name="image"
                    class="form-control"
                    accept="image/jpeg,image/png,image/webp"
                  />
                  <div class="form-text" id="posterImageHelp">
                    Required for new posters. JPG, PNG, or WebP; maximum 2MB.
                  </div>
                  <img
                    id="posterImagePreview"
                    class="img-fluid rounded mt-2 d-none"
                    alt="Current poster image"
                    style="max-height: 160px"
                  />
                </div>
              </div>
              <div id="posterFormMessage" class="alert d-none mt-3 mb-0" role="alert"></div>
            </div>

            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                Cancel
              </button>
              <button type="submit" class="btn btn-primary" id="savePosterButton">
                <span class="save-poster-label">Save Poster</span>
                <span
                  class="spinner-border spinner-border-sm d-none"
                  aria-hidden="true"
                ></span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/admin-js/main.js"></script>
    <script src="/admin-js/poster.js"></script>
  </body>
</html>
